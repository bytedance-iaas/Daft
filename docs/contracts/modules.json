   "gate": "dedup",
   "needs": [
    "raw_bytes"
   ],
   "stage": "post_verdict",
   "depends_on": [
    "funnel_verdict"
   ],
   "produces_adjudication": false,
   "param_schema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
   },
   "tables": [
    {
     "id": "dedup_groups",
     "title_zh": "重复组",
     "sortable": [
      "episode_index",
      "duplicate_of"
