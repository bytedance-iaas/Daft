   "counts_as_pending": true,
   "decisions": [
    {
     "const": "success",
     "title": "判成功"
    },
    {
     "const": "failure",
     "title": "判失败"
    },
    {
     "const": "unsure",
     "title": "拿不准"
    },
    {
     "const": "discard",
     "title": "其它原因，整条弃用"
    }
   ]
  },
  {
