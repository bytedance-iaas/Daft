    "action",
    "embodiment_profile"
   ],
   "stage": "numeric",
   "depends_on": [],
   "produces_adjudication": false,
   "param_schema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
   },
   "tables": [
    {
     "id": "kinematic_violations",
     "title_zh": "越限明细",
     "sortable": [
      "episode_index",
      "joint",
      "value"
     ],
     "default_sort": "episode_index"
    }
   ],
   "mergeable": false
  },
  {
   "id": "motion_quality",
   "name_zh": "运动质量",
   "summary_zh": "动作是否平滑、有无尖刺与执行器卡死、操作是否流畅（打分项）",
   "level": "episode",
   "gate": "soft",
   "needs": [
    "action",
    "state"
   ],
   "stage": "numeric",
   "depends_on": [],
