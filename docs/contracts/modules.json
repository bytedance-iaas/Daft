   "decisions": [
    {
     "const": "adopt_suggestion",
     "title": "采纳新标注"
    },
    {
     "const": "custom_label",
     "title": "自行改写标注"
    },
    {
     "const": "keep_label",
     "title": "维持原标注"
    },
    {
     "const": "unsure",
     "title": "拿不准"
    },
    {
     "const": "discard",
     "title": "其它原因，整条弃用"
    }
   ]
  },
  {
   "id": "task_verdict",
   "review_kind": "task_verdict",
   "title_zh": "任务成败弃权",
