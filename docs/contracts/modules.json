      "minimum": 0.2,
      "maximum": 3.0
     },
     "interpolation_gap_factor": {
      "type": "number",
      "title": "插值缺口倍数",
      "description": "相邻采样间隔超过局部中位间隔的这么多倍就不跨缺口插值",
