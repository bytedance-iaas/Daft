   ],
   "produces_adjudication": true,
   "param_schema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
   },
   "tables": [
    {
     "id": "skill_assignment",
     "title_zh": "技能归属",
     "sortable": [
      "episode_index",
      "family",
      "subskill"
     ],
     "default_sort": "episode_index"
    }
   ],
   "mergeable": false
  }
 ]
}
