{
 "registry_version": "1.0",
 "stages": [
  "numeric",
  "frame",
  "vlm",
  "post_verdict"
 ],
 "modules": [
  {
   "id": "timestamp_check",
   "name_zh": "时间戳检查",
   "summary_zh": "时间戳是否单调、有没有丢帧跳变、是不是短于残段阈值的碎片",
   "level": "episode",
   "gate": "hard",
   "needs": [
    "timestamps"
   ],
   "stage": "numeric",
   "depends_on": [],
   "produces_adjudication": false,
   "param_schema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
   },
   "tables": [
    {
     "id": "timestamp_check",
     "title_zh": "时间戳异常",
     "sortable": [
      "episode_index",
      "duration_s",
      "max_dt"
     ],
     "default_sort": "episode_index"
    }
   ],
   "mergeable": false
  },
  {
   "id": "kinematic_limits",
   "name_zh": "运动学极限",
   "summary_zh": "对照机器人规格库检查关节位置与速度是否越限",
   "level": "episode",
