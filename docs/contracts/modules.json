   "gate": "hard",
   "needs": [
    "timestamps"
   ],
   "stage": "numeric",
   "depends_on": [],
   "produces_adjudication": false,
   "review_lines": [],
   "appealable": false,
   "input_scope": "funnel",
   "affects_dataset_verdict": true,
   "param_schema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
   },
   "tables": [
    {
     "id": "timestamp_check",
     "title_zh": "时间戳异常",
     "sortable": [
      "episode_index",
      "duration_s",
      "max_dt"
     ],
     "default_sort": "episode_index"
    }
   ],
   "mergeable": false
  },
