{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EEF-video 1.0.0 calibration",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "eef-video/1.0.0"
    },
    "calibrations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "camera_id": {
            "type": "string",
            "minLength": 1
          },
          "reference_frame": {
            "type": "string",
            "minLength": 1
          },
          "image_size_wh": {
            "$ref": "#/$defs/size"
          },
          "image_space": {
            "enum": [
              "rectified",
              "distorted"
            ]
          },
          "model": {
            "enum": [
              "pinhole",
              "opencv_brown",
              "opencv_fisheye"
            ]
          },
          "K": {
            "$ref": "#/$defs/mat3"
          },
          "distortion_coefficients": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "extrinsics_mode": {
            "enum": [
              "static",
              "per_frame"
            ]
          },
          "T_reference_camera": {
            "anyOf": [
              {
                "$ref": "#/$defs/mat4"
              },
              {
                "type": "null"
              }
            ]
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          }
        },
        "required": [
          "camera_id",
          "reference_frame",
          "image_size_wh",
          "image_space",
          "model",
          "K",
          "distortion_coefficients",
          "extrinsics_mode",
          "T_reference_camera",
          "provenance"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "extrinsics_mode": {
                  "const": "static"
                }
              },
              "required": [
                "extrinsics_mode"
              ]
            },
            "then": {
              "properties": {
                "T_reference_camera": {
                  "$ref": "#/$defs/mat4"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "extrinsics_mode": {
                  "const": "per_frame"
                }
              },
              "required": [
                "extrinsics_mode"
              ]
            },
            "then": {
              "properties": {
                "T_reference_camera": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "model": {
                  "const": "pinhole"
                }
              },
              "required": [
                "model"
              ]
            },
            "then": {
              "properties": {
                "distortion_coefficients": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "model": {
                  "const": "opencv_brown"
                }
              },
              "required": [
                "model"
              ]
            },
            "then": {
              "properties": {
                "distortion_coefficients": {
                  "minItems": 5,
                  "maxItems": 5
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "model": {
                  "const": "opencv_fisheye"
                }
              },
              "required": [
                "model"
              ]
            },
            "then": {
              "properties": {
                "distortion_coefficients": {
                  "minItems": 4,
                  "maxItems": 4
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "image_space": {
                  "const": "rectified"
                }
              },
              "required": [
                "image_space"
              ]
            },
            "then": {
              "properties": {
                "model": {
                  "const": "pinhole"
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "calibrations"
  ],
  "additionalProperties": false,
  "$defs": {
    "mat3": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "minItems": 3,
      "maxItems": 3
    },
    "mat4": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 4,
        "maxItems": 4
      },
      "minItems": 4,
      "maxItems": 4
    },
    "size": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "assurance": {
          "enum": [
            "declared",
            "model_assumed",
            "independently_calibrated",
            "unknown",
            "synthetic"
          ]
        }
      },
      "required": [
        "source",
        "method",
        "assurance"
      ],
      "additionalProperties": false
    }
  }
}
