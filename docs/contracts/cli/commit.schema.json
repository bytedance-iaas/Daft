{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "revisions/r<NNNN>/commit.json (schema 1.0)",
  "description": "Written last into a result revision; readers only trust revisions that have it (design doc 06, section 1). The Daemon switches task.result_rev to it with a CAS once the revision is uploaded and verified (D25).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "created_at", "source_digest", "parts", "adjudications_applied", "subtask_id", "files"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "revision": {"$ref": "common.schema.json#/$defs/revision"},
    "created_at": {"$ref": "common.schema.json#/$defs/epoch_ms"},
    "source_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "parts": {
      "type": "object",
      "description": "which parts of each module's results this revision was built from",
      "propertyNames": {"$ref": "common.schema.json#/$defs/module_id"},
      "additionalProperties": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/part_id"}}
    },
    "adjudications_applied": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "subtask_id": {"type": ["string", "null"]},
    "files": {
      "type": "object",
      "description": "every other file of the revision with its sha256",
      "additionalProperties": {"$ref": "common.schema.json#/$defs/digest"}
    }
  }
}
