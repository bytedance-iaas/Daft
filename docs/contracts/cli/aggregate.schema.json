{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "curation aggregate --json (schema 1.0)",
  "description": "Pure computation, recomputed in full every time (design doc 02, section 3.6): --phase final writes the four lists into the revision given by --revision, and the verdict lines beside them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "revision",
    "counts",
    "files"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "phase": {
      "const": "final"
    },
    "revision": {
      "$ref": "common.schema.json#/$defs/revision"
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "required": [
        "total",
        "passed",
        "reject",
        "held",
        "review"
      ]
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "required": [
        "passed",
        "reject",
        "held",
        "review"
      ]
    }
  }
}
