{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "export/manifest.json (schema 1.0)",
  "description": "What the delivered dataset holds, the basis of incremental re-export (design doc 06, section 4.3).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_format", "fingerprint", "episodes", "meta_files"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "source_format": {"enum": ["lerobot_v2", "lerobot_v3"]},
    "fingerprint": {"$ref": "common.schema.json#/$defs/digest", "description": "export fingerprint: passed list and order, task texts and sources, source digest, format and parameters"},
    "episodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["episode_index", "new_index", "content_key", "task_key", "artifacts"],
        "properties": {
          "episode_index": {"$ref": "common.schema.json#/$defs/episode_index"},
          "new_index": {"$ref": "common.schema.json#/$defs/episode_index"},
          "content_key": {"$ref": "common.schema.json#/$defs/digest"},
          "task_key": {"$ref": "common.schema.json#/$defs/digest"},
          "task": {
            "type": "object",
            "additionalProperties": false,
            "description": "the task text written for the episode and where it came from; also in meta/curation_episodes.jsonl of the delivered dataset",
            "required": ["text", "source"],
            "properties": {"text": {"type": "string"}, "source": {"$ref": "common.schema.json#/$defs/task_text_source"}}
          },
          "artifacts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["parquet", "videos"],
            "properties": {
              "parquet": {"type": "string"},
              "videos": {"type": "object", "additionalProperties": {"type": "string"}},
              "chunk": {"type": "integer", "minimum": 0, "description": "v3: linear index of the data file the episode lives in, chunk_index * chunks_size + file_index"}
            }
          }
        }
      }
    },
    "meta_files": {"type": "array", "items": {"type": "string"}},
    "files": {
      "type": "object",
      "description": "every file of the delivered dataset, relative to export/lerobot_curated/, with size and sha256; verify reads it back against these",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["size", "sha256"],
        "properties": {"size": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "common.schema.json#/$defs/digest"}}
      }
    }
  }
}
