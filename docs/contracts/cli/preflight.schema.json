{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "curation preflight --json (schema 1.0)",
  "description": "Design doc 02, section 3.1; availability rules in doc 05, section 4. Reads metadata only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "format", "validation", "dataset", "modules", "meta_fingerprint", "warnings"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "supported", "detail"],
      "properties": {
        "kind": {"enum": ["lerobot", "mcap", "lancedb", "rrd", "unknown"]},
        "version": {"enum": ["v2", "v3", null]},
        "supported": {"type": "boolean", "description": "false => every module is unsupported"},
        "detail": {"type": "string"}
      }
    },
    "validation": {"type": "array", "items": {"type": "string"}, "description": "info.json problems, shown to the user verbatim; non-empty => supported=false"},
    "dataset": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["episode_count", "cameras", "fps", "robot_type", "total_frames", "labels", "profile"],
          "properties": {
            "episode_count": {"type": "integer", "minimum": 0, "description": "episodes are 0 .. count-1"},
            "cameras": {"type": "array", "items": {"type": "string"}},
            "fps": {"type": ["number", "null"]},
            "robot_type": {"type": ["string", "null"]},
            "total_frames": {"type": ["integer", "null"]},
            "labels": {
              "type": "object",
              "additionalProperties": false,
              "required": ["with_task", "without_task"],
              "properties": {
                "with_task": {"type": "integer", "minimum": 0},
                "without_task": {"type": "integer", "minimum": 0}
              }
            },
            "profile": {
              "oneOf": [
                {"type": "null"},
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["matched", "by"],
                  "properties": {"matched": {"type": "string"}, "by": {"type": "string"}}
                }
              ]
            }
          }
        }
      ]
    },
    "modules": {"type": "array", "items": {"$ref": "#/$defs/module_availability"}},
    "meta_fingerprint": {"$ref": "common.schema.json#/$defs/digest"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "module_availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "availability"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/module_id"},
        "availability": {"enum": ["available", "needs_input", "unsupported"]},
        "reason": {"type": "string"},
        "input_hint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field"],
          "properties": {
            "field": {"enum": ["embodiment_id", "vlm"]},
            "options": {"type": "array", "items": {"type": "string"}}
          }
        },
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {"if": {"properties": {"availability": {"const": "unsupported"}}}, "then": {"required": ["reason"]}},
        {"if": {"properties": {"availability": {"const": "needs_input"}}}, "then": {"required": ["reason", "input_hint"]}}
      ]
    }
  }
}
