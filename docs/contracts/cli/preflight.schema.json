{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "curation preflight --json (schema 1.0)",
  "description": "Design doc 02, section 3.1; availability rules in doc 05, section 4. Reads metadata only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "format", "validation", "dataset", "modules", "meta_fingerprint", "warnings"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "supported", "detail"],
      "properties": {
        "kind": {"enum": ["lerobot", "mcap", "lancedb", "rrd", "unknown"]},
        "version": {"enum": ["v2", "v3", null]},
        "supported": {"type": "boolean", "description": "false => every module is unsupported"},
        "detail": {"type": "string"}
      }
    },
    "validation": {"type": "array", "items": {"type": "string"}, "description": "info.json problems, shown to the user verbatim; non-empty => supported=false"},
    "dataset": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["episode_count", "cameras", "fps", "robot_type", "total_frames", "labels", "profile"],
          "properties": {
            "episode_count": {"type": "integer", "minimum": 0, "description": "episodes are 0 .. count-1"},
            "cameras": {"type": "array", "items": {"type": "string"}, "description": "short camera names: the video feature key without the observation.images. prefix"},
            "fps": {"type": ["number", "null"]},
            "robot_type": {"type": ["string", "null"]},
            "total_frames": {"type": ["integer", "null"]},
            "labels": {
              "type": "object",
              "additionalProperties": false,
              "required": ["with_task", "without_task"],
              "properties": {
                "with_task": {"type": "integer", "minimum": 0},
                "without_task": {"type": "integer", "minimum": 0}
              }
            },
            "profile": {
              "oneOf": [
                {"type": "null"},
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["matched", "by"],
                  "properties": {"matched": {"type": "string"}, "by": {"type": "string"}}
                }
              ]
            }
          }
        }
      ]
    },
    "modules": {"type": "array", "items": {"$ref": "#/$defs/module_availability"}},
    "meta_fingerprint": {"$ref": "common.schema.json#/$defs/digest", "description": "the listing fingerprint (source-manifest summary.digest) computed over the metadata objects only"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "module_availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "availability"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/module_id"},
        "availability": {"enum": ["available", "needs_input", "unsupported"]},
        "reason": {"type": "string", "description": "English, for the terminal and logs; UIs render reason_code instead"},
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Stable reason for UIs to translate. Known codes: format_unsupported {detected}, metadata_invalid {problem}, missing_input {missing: [timestamps|action|state|video], video_cause?: none_declared|files_missing}, embodiment_unsupported {subject, given_by: robot_type|embodiment_id, supported}, robot_type_unknown {robot_type}, vlm_backend_missing; EEF-video consistency (design doc 12 §5.1): trajectory_missing {path?}, trajectory_invalid {errors, sha256}, eef_review_not_available, and as sub-item reasons projection_missing, observation_seed_missing and the rest of that catalogue. New modules may add codes; a UI that does not know one shows reason."
        },
        "reason_args": {"type": "object", "description": "parameters of reason_code, listed with each code"},
        "input_hint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field"],
          "properties": {
            "field": {"enum": ["embodiment_id", "vlm", "trajectory_json"], "description": "trajectory_json (C1 1.5): the module's upload parameter of that name"},
            "options": {"type": "array", "items": {"type": "string"}}
          }
        },
        "notes": {"type": "array", "items": {"type": "string"}},
        "subitems": {
          "type": "object",
          "description": "Per sub-item capability of a module that has sub-items (EEF-video consistency, design doc 12 §5.1): the best availability of each sub-item over the selected episodes, with a reason when none is available",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["availability", "reason_code"],
            "properties": {
              "availability": {"enum": ["available", "needs_input", "unsupported"]},
              "reason_code": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*$"}
            }
          }
        },
        "episode_counts": {
          "type": "object",
          "description": "Modules with per-episode inputs (EEF-video consistency): the selected episodes by availability",
          "propertyNames": {"enum": ["available", "needs_input", "unsupported"]},
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      },
      "allOf": [
        {"if": {"properties": {"availability": {"const": "unsupported"}}}, "then": {"required": ["reason", "reason_code"]}},
        {"if": {"properties": {"availability": {"const": "needs_input"}}}, "then": {"required": ["reason", "reason_code", "input_hint"]}}
      ]
    }
  }
}
