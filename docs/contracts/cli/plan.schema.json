{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "curation plan --json / plan.json (schema 2.0)",
  "description": "The execution plan the planner derives (design doc 04, section 3). It is data: the Daemon stores it with the task, schedules by it and serves it read-only. Callers can only lower the limits it is derived from (D31). Two blocks (design doc 17 §3.3): every check stage names its block (cpu / vlm) and the stage before it in that block (after); every stage reads the task's selection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vlm_parallelism",
    "limits",
    "stages",
    "estimates"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version_2"
    },
    "vlm_parallelism": {
      "type": "integer",
      "minimum": 1,
      "description": "the effective N the VLM gates are derived from"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "description": "The upper bounds the plan honoured, and where each came from.",
      "required": [
        "cpu_concurrency",
        "vlm_parallelism"
      ],
      "properties": {
        "cpu_concurrency": {
          "$ref": "#/$defs/limit",
          "description": "The most CPU workers this task may use: every core but two (planner) or the task's cap (task), whichever is lower (P4, D54). Under the Daemon, the workers of all running tasks share one pool of that many slots."
        },
        "vlm_parallelism": {
          "$ref": "#/$defs/limit"
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "estimates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vlm_requests",
        "wall_clock_s",
        "notes"
      ],
      "properties": {
        "vlm_requests": {
          "type": "integer",
          "minimum": 0
        },
        "wall_clock_s": {
          "type": "number",
          "minimum": 0
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "bound_by"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 1
        },
        "bound_by": {
          "enum": [
            "task",
            "model",
            "backend",
            "site",
            "planner",
            "running_tasks"
          ]
        }
      }
    },
    "gates": {
      "type": "object",
      "description": "Concurrency gates of a stage: episode (the VLM stage's episodes in flight) and probe (its model requests); a module may declare its own, named like a module id.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      },
      "properties": {
        "episode": {
          "type": "integer",
          "minimum": 1
        },
        "probe": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "groups"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "none",
            "per_episode_multi_module"
          ]
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "modules",
              "frame_policy"
            ],
            "properties": {
              "modules": {
                "$ref": "common.schema.json#/$defs/module_list"
              },
              "frame_policy": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "the registry's stages (integrity, numeric, frame, duplicate, vlm_prep; vlm) and final; stages of new modules follow the same pattern"
        },
        "kind": {
          "enum": [
            "cpu",
            "vlm",
            "aggregate"
          ]
        },
        "command": {
          "enum": [
            "check",
            "aggregate"
          ]
        },
        "modules": {
          "$ref": "common.schema.json#/$defs/module_list"
        },
        "episodes": {
          "const": "selected",
          "description": "the episode set a stage reads: the task's selection (every stage reads all of it)"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "gates": {
          "$ref": "#/$defs/gates"
        },
        "merge": {
          "$ref": "#/$defs/merge"
        },
        "phase": {
          "enum": [
            "final"
          ]
        },
        "block": {
          "enum": [
            "cpu",
            "vlm"
          ],
          "description": "the block the stage runs in"
        },
        "after": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "the stage before it in its block; a block's first stage and a second root (vlm_prep) have none. The one edge across the blocks: vlm after vlm_prep when a module of vlm ran its CPU part there - an episode reaches vlm once vlm_prep is done with it"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "aggregate"
              }
            }
          },
          "then": {
            "required": [
              "phase"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "cpu",
                  "vlm"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "episodes",
              "block"
            ]
          }
        }
      ]
    }
  }
}
