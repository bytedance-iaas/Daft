{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared definitions for the CLI contracts (schema 1.0)",
  "$defs": {
    "schema_version": {"const": "1.0"},
    "episode_index": {"type": "integer", "minimum": 0},
    "episode_list": {"type": "array", "items": {"$ref": "#/$defs/episode_index"}, "uniqueItems": true},
    "skipped_episodes": {
      "type": "array",
      "description": "episodes left out because source files are missing (D40, as v1 does): never read, no result line, in none of the lists, not part of total",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["episode_index", "missing"],
        "properties": {
          "episode_index": {"$ref": "#/$defs/episode_index"},
          "missing": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "description": "the missing object keys, relative to the input"}
        }
      }
    },
    "module_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "module_list": {"type": "array", "items": {"$ref": "#/$defs/module_id"}, "uniqueItems": true},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "part_id": {"type": "string", "pattern": "^[0-9]{4}$"},
    "revision": {"type": "integer", "minimum": 1},
    "epoch_ms": {"type": "integer", "minimum": 0},
    "uri": {"type": "string", "minLength": 1, "description": "tos://bucket/prefix or a local path"},
    "task_text_source": {
      "enum": ["原始标注", "自产caption", "人工改标", "无"],
      "description": "Where a task text came from; the values are v1's and are written into the delivered dataset as instruction_source."
    },
    "incident": {
      "type": "object",
      "required": ["step"],
      "properties": {
        "step": {"type": "string"},
        "cause": {"type": "string"},
        "camera": {"type": "string"},
        "call_kind": {"type": "string"},
        "attempts": {"type": "integer", "minimum": 0}
      }
    },
    "execution_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "incidents"],
      "properties": {
        "kind": {"const": "execution"},
        "incidents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/incident"}}
      }
    },
    "verdict_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "pass", "fail", "abstain", "scored", "error"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "abstain": {"type": "integer", "minimum": 0},
        "scored": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0}
      }
    }
  }
}
