{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C6 - taxonomy of check items (taxonomy 2.0)",
  "description": "docs/contracts/taxonomy.json (design doc 17 §1.3, D56). The items a finding can name: while sample set v1 is a draft ids may change (1.3 dropped five items and the kind reference, 2.0 numbered every dimension again; renumbered maps the previous ids); ids of different versions are not comparable. kind control marks a legal case that must not be reported; guards lists the items it protects from false alarms.",
  "type": "object",
  "additionalProperties": false,
  "required": ["taxonomy_version", "description", "kinds", "levels", "dimensions", "items"],
  "properties": {
    "taxonomy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "description": {"type": "string"},
    "kinds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defect", "phenomenon", "control"],
      "properties": {
        "defect": {"type": "string"},
        "phenomenon": {"type": "string"},
        "control": {"type": "string"}
      }
    },
    "levels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode", "dataset"],
      "properties": {"episode": {"type": "string"}, "dataset": {"type": "string"}}
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name_zh"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z]+$"},
          "name_zh": {"type": "string", "minLength": 1}
        }
      }
    },
    "renumbered": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_version", "ids"],
      "description": "how the ids of the previous version map to this one; only the ids that changed are listed",
      "properties": {
        "from_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "ids": {"type": "object", "propertyNames": {"$ref": "#/$defs/item_id"}, "additionalProperties": {"$ref": "#/$defs/item_id"}},
        "note": {"type": "string"}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "item_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]+$"},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dimension", "name_zh", "explain_zh", "kind", "level"],
      "properties": {
        "id": {"$ref": "#/$defs/item_id"},
        "dimension": {"type": "string", "pattern": "^[A-Z]+$", "description": "the id prefix: FILE-3 is in FILE"},
        "name_zh": {"type": "string", "minLength": 1},
        "explain_zh": {"type": "string", "minLength": 1, "description": "what the problem is, in plain Chinese"},
        "kind": {"enum": ["defect", "phenomenon", "control"]},
        "level": {"enum": ["episode", "dataset"], "description": "judged per episode or once per dataset"},
        "guards": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/item_id"},
          "description": "control items only: the items that must not be reported on such a sample"
        }
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "control"}}}, "then": {"required": ["guards"]},
         "else": {"not": {"required": ["guards"]}}}
      ]
    }
  }
}
