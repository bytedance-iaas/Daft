{
 "schema_version": "1.0",
 "version": "1.1",
 "taxonomy_version": "1.0",
 "platform": "curation v2, module registry (C1) 1.14",
 "about": "How a platform result becomes a check item (taxonomy.json). A rule reads one module's per-episode record (checks/<module>/results.jsonl) and yields the items it reports, with the camera when the record names one. An item a rule can yield is 'mapped'; the modules whose rules yield it decide whether an episode was assessed for it. Thresholds are the platform's own where it has one (visual_quality freezes at 95%, the report calls a camera reading below 0.6 low, the funnel's soft threshold is 0.5).",
 "rules": [
  {"id": "integrity.file_empty", "module": "data_integrity", "match": {"finding_codes": ["file_empty"]}, "items": ["FILE-1"]},
  {"id": "integrity.stream_missing", "module": "data_integrity", "match": {"finding_codes": ["stream_missing"]}, "items": ["STRM-1"]},
  {"id": "integrity.truncated", "module": "data_integrity", "match": {"finding_codes": ["file_truncated", "zero_filled"]}, "items": ["FILE-2"]},
  {"id": "integrity.mcap_structure", "module": "data_integrity", "match": {"finding_codes": ["structure_invalid", "crc_mismatch", "cut_off"]}, "items": ["FILE-3"]},
  {"id": "integrity.decode", "module": "data_integrity", "match": {"finding_codes": ["decode_failed", "decode_concealed"]}, "items": ["FILE-4"]},
  {"id": "integrity.frame_count", "module": "data_integrity", "match": {"finding_codes": ["count_mismatch", "table_inconsistent"]}, "items": ["FILE-5"]},
  {"id": "integrity.rows_values", "module": "data_integrity", "match": {"finding_codes": ["row_invalid"], "message_regex": "NaN|Inf|二维|dtype"}, "items": ["FILE-6"]},
  {"id": "integrity.rows_time", "module": "data_integrity", "match": {"finding_codes": ["row_invalid"], "message_regex": "时间戳"}, "items": ["STRM-4"]},
  {"id": "integrity.rows_length", "module": "data_integrity", "match": {"finding_codes": ["row_invalid"], "message_regex": "长度|帧数"}, "items": ["FILE-5"]},
  {"id": "integrity.rows_missing_video", "module": "data_integrity", "match": {"finding_codes": ["row_invalid"], "message_regex": "视频文件不存在"}, "items": ["FILE-1"]},
  {"id": "integrity.rows_metadata", "module": "data_integrity", "match": {"finding_codes": ["row_invalid"], "message_regex": "fps 非法|时间边界非法"}, "items": ["FILE-8"]},
  {"id": "integrity.rows_no_action", "module": "data_integrity", "match": {"finding_codes": ["row_invalid"], "message_regex": "action 缺失"}, "items": ["STRM-1"]},
  {"id": "integrity.rate", "module": "data_integrity", "match": {"finding_codes": ["rate_outlier"]}, "items": ["STRM-3"]},
  {"id": "integrity.duplicate", "module": "data_integrity", "match": {"finding_codes": ["duplicate_content"]}, "items": ["SET-1"]},
  {"id": "timestamp.gap", "module": "timestamp_check", "match": {"timestamp_fail_kinds": ["gap", "jitter"]}, "items": ["STRM-3"]},
  {"id": "timestamp.order", "module": "timestamp_check", "match": {"timestamp_fail_kinds": ["out_of_order"]}, "items": ["STRM-4"]},
  {"id": "timestamp.fragment", "module": "timestamp_check", "match": {"timestamp_fail_kinds": ["fragment"]}, "items": ["STRM-5"]},
  {"id": "timestamp.single_stamp", "module": "timestamp_check", "match": {"timestamp_fail_kinds": ["other"], "reason_regex": "个时间戳"}, "items": ["STRM-5"]},
  {"id": "kinematics.limits", "module": "kinematic_limits", "match": {"violation_types": ["joint_limit", "velocity_limit", "ee_reach", "ee_translation_velocity", "ee_rotation_velocity"]}, "items": ["ACT-4"]},
  {"id": "motion.smoothness", "module": "motion_quality", "match": {"subscore": "smoothness", "below": 0.5}, "items": ["ACT-1"]},
  {"id": "motion.spike", "module": "motion_quality", "match": {"subscore": "spike", "below": 0.5}, "items": ["ACT-2"]},
  {"id": "motion.stuck", "module": "motion_quality", "match": {"detail_nonempty": "stuck_joints"}, "items": ["ACT-8"]},
  {"id": "motion.gripper_jitter", "module": "motion_quality", "match": {"subscore": "gripper_jitter", "below": 0.5}, "items": ["ACT-5"]},
  {"id": "motion.saturation", "module": "motion_quality", "match": {"subscore": "actuator_saturation", "below": 0.5}, "items": ["ACT-4"]},
  {"id": "motion.fluency", "module": "motion_quality", "match": {"subscore": "fluency", "below": 0.5}, "items": ["TASK-8"]},
  {"id": "visual.frozen", "module": "visual_quality", "match": {"camera_detail": "frozen_ratio", "at_least": 0.95}, "items": ["IMG-1"]},
  {"id": "visual.dead_or_padded", "module": "visual_quality", "match": {"camera_list": "camera_liveness.dead_or_padded"}, "items": ["STRM-1"]},
  {"id": "visual.exposure", "module": "visual_quality", "match": {"camera_detail": "exposure", "below": 0.6}, "items": ["IMG-2"]},
  {"id": "visual.sharpness", "module": "visual_quality", "match": {"camera_detail": "sharpness", "below": 0.6}, "items": ["IMG-4"]},
  {"id": "sync.all_cameras", "module": "video_action_sync", "match": {"detail_verdicts": ["misaligned_all"]}, "items": ["AV-1"]},
  {"id": "sync.one_camera", "module": "video_action_sync", "match": {"camera_codes": ["misaligned"]}, "items": ["AV-1"]},
  {"id": "eef.reject", "module": "eef_video_consistency", "match": {"passed": [false]}, "items": ["MV-5"]},
  {"id": "eef.human", "module": "eef_video_consistency", "match": {"detail_outcomes": ["human"]}, "items": ["MV-5"]},
  {"id": "task.failure", "module": "task_success", "match": {"passed": [false]}, "items": ["TASK-5"]},
  {"id": "task.label_conflict", "module": "task_success", "match": {"detail_verdicts": ["label_conflict_suspect"]}, "items": ["LABEL-5"]},
  {"id": "camera_defects.glitch", "module": "camera_defects", "match": {"camera_levels": {"key": "glitch", "levels": ["minor", "severe"]}}, "unknown_when": {"detail": "items.glitch", "values": ["unknown"]}, "items": ["IMG-5"]},
  {"id": "camera_defects.shake", "module": "camera_defects", "match": {"camera_levels": {"key": "shake", "levels": ["minor", "severe"]}}, "unknown_when": {"detail": "items.shake", "values": ["unknown"]}, "items": ["IMG-6"]},
  {"id": "camera_defects.contamination", "module": "camera_defects", "match": {"camera_levels": {"key": "contamination", "levels": ["minor", "severe"]}}, "unknown_when": {"detail": "items.contamination", "values": ["unknown"]}, "items": ["IMG-7"]},
  {"id": "dedup.duplicate", "module": "dedup", "match": {"passed": [false]}, "items": ["SET-1"]}
 ],
 "controls": {
  "about": "A control item marks a legitimate situation; the platform passes it when it reports none of not_items on the episode and, with not_drop, does not drop the episode.",
  "items": {
   "FILE-9": {"not_items": ["FILE-2", "FILE-4"], "not_drop": true},
   "STRM-8": {"not_items": ["STRM-3", "AV-1"], "not_drop": false},
   "IMG-10": {"not_items": ["IMG-1", "IMG-2"], "not_drop": true},
   "IMG-11": {"not_items": ["IMG-2", "IMG-4"], "not_drop": true},
   "ACT-9": {"not_items": ["ACT-4"], "not_drop": false},
   "TASK-9": {"not_items": ["TASK-8"], "not_drop": false},
   "SET-2": {"not_items": ["SET-1"], "not_drop": false}
  }
 },
 "ingestion": {"about": "SET-4 marks an input format the platform should read; a subset counts as handled when its preflight reports the format as supported.", "items": ["SET-4"]}
}
